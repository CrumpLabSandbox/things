---
import Base from "../layouts/Base.astro";
import BrowseNav from "../components/BrowseNav.astro";
import "../styles/explore.css";
---
<Base title="Explore" description="Browse the collection by tag, text and similarity." wide>
  <div class="page-head">
    <h1>Explore</h1>
    <p>Filter by tag, search the descriptions, or switch to the map, where similar pieces sit close together.</p>
  </div>
  <BrowseNav />
  <div id="explore" class="x-app" data-base={import.meta.env.BASE_URL}>
    <div class="x-side">
      <input id="x-search" type="search" placeholder="search titles, tags, descriptions" autocomplete="off" />
      <div class="x-controls">
        <label>sort
          <select id="x-sort">
            <option value="date-desc">newest first</option>
            <option value="date-asc">oldest first</option>
            <option value="series">by series</option>
            <option value="saturation">most colourful</option>
            <option value="edges">most line</option>
            <option value="busyness">busiest</option>
            <option value="lightness">lightest</option>
          </select>
        </label>
        <button id="x-clear" type="button">clear filters</button>
      </div>
      <div id="x-active" class="x-active"></div>
      <div id="x-facets"></div>
    </div>
    <div class="x-main">
      <div class="x-bar">
        <span id="x-count"></span>
        <span class="x-views">
          <button type="button" data-view="grid" class="is-on">grid</button>
          <button type="button" data-view="map">map</button>
        </span>
      </div>
      <div id="x-grid" class="x-grid"></div>
      <div id="x-map" class="x-map" hidden></div>
    </div>
    <div id="x-detail" class="x-detail" hidden></div>
  </div>
</Base>

<script>
  import "../scripts/explore.js";
</script>
