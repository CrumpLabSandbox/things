---
import Base from "../layouts/Base.astro";
import Gallery from "../components/Gallery.astro";
import BrowseNav from "../components/BrowseNav.astro";
import { works, seriesList } from "../lib/data";
const series = seriesList();
---
<Base wide>
  <div class="page-head">
    <h1>things by Matt Crump</h1>
    <p>Paintings, drawings and pictures, 2008 to now. {works.length} pieces in {series.length} series.</p>
  </div>
  <BrowseNav />
  <Gallery items={works} />
</Base>
