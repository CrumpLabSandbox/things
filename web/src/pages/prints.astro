---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Gallery from "../components/Gallery.astro";
import { works } from "../lib/data";
import { img } from "../lib/images";
const forSale = works.filter((w) => w.catalog.print_url);
---
<Base title="Buy prints" description="Options for purchasing prints." image="prints/SpecSheet.png" wide>
  <div class="prints">
    <div class="prose">
      <h1>Buy prints</h1>
      <p>Open edition prints are available through my Shopify storefront:</p>
      <p><a class="button" href="https://mattcrump.myshopify.com">mattcrump.myshopify.com</a></p>
      <p>Prints are on matte art paper in very high resolution. I've been very happy with them. There is also a framing option. Prints ship rolled. Framed prints ship with the print in the frame.</p>
      <p>Limited editions and commissions may also be available from time to time.</p>
    </div>
    <Image src={img("prints/SpecSheet.png")} alt="Print specification sheet" width={520} densities={[1, 2]} class="spec" />
  </div>
  {forSale.length > 0 && (<>
    <h2>Pieces with prints available</h2>
    <Gallery items={forSale} />
  </>)}
</Base>

<style>
  .prints { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 520px); gap: 2rem; align-items: start; margin-bottom: 1rem; }
  @media (max-width: 860px) { .prints { grid-template-columns: minmax(0, 1fr); } }
  .spec { width: 100%; border-radius: var(--radius); }
</style>
