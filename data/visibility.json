    "catalog.kind",
    "catalog.year",
    "catalog.date",
    "catalog.availability",
    "catalog.physical_size_in",
    "catalog.image.path",
    "catalog.image.width",
    "catalog.image.height",
    "catalog.image.aspect",
    "catalog.image.orientation",
    "catalog.page.html",
    "measured.palette",
    "measured.dominant_hues",
    "measured.mean_saturation",
    "measured.contrast",
    "measured.colorfulness",
    "measured.is_monochrome",
    "measured.edge_density",
    "measured.busyness",
    "measured.thumbnail",
    "described.alt_text",
    "described.subjects",
    "described.characters",
    "described.elements",
    "described.setting",
